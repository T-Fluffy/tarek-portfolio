# App title shown in <title>
VITE_APP_TITLE=TFluffy's Portfolio

# Full URL of the hosted backend (Render). Used by GitHub Pages / static builds.
# For the Docker nginx stack leave this EMPTY (''): nginx proxies /api -> BACKEND_URL.
VITE_API_URL=https://your-api.onrender.com

# Vite base path. '/tarek-portfolio/' for GitHub Pages; '/' for Docker / self-hosting.
VITE_BASE_PATH=/tarek-portfolio/

# Used by docker-compose(.dev).yml to point nginx / the dev proxy at your backend.
BACKEND_URL=https://your-api.onrender.com