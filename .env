VITE_APP_TITLE="TFluffy's Portfolio"

# Backend URL used by docker-compose(.dev).yml (nginx /api proxy + dev proxy)
BACKEND_URL=https://tarek-portfolio-backend.onrender.com

# For local static builds (e.g. manual `npm run build`), set the full backend URL.
# Leave empty for the Docker nginx stack (it proxies /api -> BACKEND_URL).
VITE_API_URL=
